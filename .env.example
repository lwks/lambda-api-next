# Export these variables in the server process. npm start does not load .env automatically.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@clusterjobs.com.br
SMTP_FROM_NAME=Cluster
# Generate a separate random server-only token (at least 32 random bytes).
EMAIL_SERVICE_TOKEN=
